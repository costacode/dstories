---
import Icon from "../components/icon.astro";
// Get the current pathname from Astro's global object
const { pathname } = Astro.url;
---

<nav class="nav-top">
	<ul>
		<li class={pathname === "/" ? "active" : ""}>
			<a href="/">
				<div class="nav-dslogo">
					<Icon icon="logo" />
				</div>
			</a>
		</li>
		<li class={pathname === "/about/" ? "active" : ""}>
			<a href="/about/"> About </a>
		</li>
		<li class={pathname === "/cv/" ? "active" : ""}>
			<a href="/cv/"> CV </a>
		</li>
	</ul>
</nav>

<style>
	/* styles inside components are scoped */
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	a {
		text-decoration: none;
		color: currentColor;

		&:hover,
		&:focus-visible {
			color: var(--clr-blue-700);
		}
	}
</style>
