---
import Icon from "../components/icon.astro";
// Get the current pathname from Astro's global object
const { pathname } = Astro.url;
---

<nav class="nav-top">
    <ul>
        {pathname !== "/" && (
            <li>
                <a href="/">
                    <div class="nav-dslogo">
                        <Icon icon="logo" />
                    </div>
                </a>
            </li>
        )}
        {pathname !== "/about/" && (
            <li>
                <a href="/about/"> About </a>
            </li>
        )}
        {pathname !== "/cv/" && (
            <li>
                <a href="/cv/"> CV </a>
            </li>
        )}
    </ul>
</nav>

<style>
	/* styles inside components are scoped */
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	a {
		text-decoration: none;
		color: currentColor;

		&:hover,
		&:focus-visible {
			color: var(--clr-blue-700);
		}
	}
</style>
