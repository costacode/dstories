---
import Icon from "../components/icon.astro";
const title = "Designing Stories";
---

<nav class="nav-top">
	<ul>
		<li>
			<a href="/">
				<div class="nav-dslogo">
					<Icon icon="logo" />
				</div>
			</a>
		</li>
	</ul>
</nav>

<style>
	/* styles inside components are scoped */

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	a {
		text-decoration: none;
		color: currentColor;

		&:hover,
		&:focus-visible {
			color: var(--clr-blue-700);
		}
	}

	.nav-top {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		background-color: transparent;
		width: auto;
		position: fixed;
		top: 2rem;
		left: 0;
		z-index: 2;

		a {
			display: block;
			padding: 2rem 1rem;
		}

		.nav-dslogo {
			display: block;
			width: 8rem;
		}

		/* .hero-dslogo {
            width: 116px;
        } */
	}

