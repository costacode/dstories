---
import Icon from "../components/icon.astro";
const title = "Designing Stories";
---

<nav class="nav-top">
	<ul>
		<li>
			<a href="/">
				<div class="nav-dslogo">
					<Icon icon="logo" />
				</div>
			</a>
		</li>
	</ul>
</nav>

<style>
	/* styles inside components are scoped */
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	a {
		text-decoration: none;
		color: currentColor;

		&:hover,
		&:focus-visible {
			color: var(--clr-blue-700);
		}
	}
</style>
