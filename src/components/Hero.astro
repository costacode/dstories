---
import Icon from "../components/icon.astro";
const title = "Designing Stories";
---

<section class="hero">
	<div class="hero-dslogo">
		<Icon icon="logo" />
	</div>
	<header>
		<h1 class="visually-hidden">{title}</h1>

		<p class="hero-intro bounceText">
			A space cultivated<br />
			by <a href="/about/" id="link-about" class="link-about">Jesus Acosta</a>
		</p>
	</header>
</section>
<div class="js-lottie lottie-container" id="lottie-container"></div>

<script>
	import lottie from "lottie-web";
	fetch("/images/talltree.json")
		.then((res) => res.json())
		.then((tree) => {
			lottie.loadAnimation({
				container: document.getElementById("lottie-container"),
				renderer: "svg",
				loop: false,
				autoplay: true,
				animationData: tree,
			});
		});

	setTimeout(() => {
		const heroElement = document.querySelector(".hero");
		if (heroElement) {
			heroElement.classList.add("slide-in");
		}
	}, 3000);
</script>

<script type="module" is:inline>
	setTimeout(() => {
		const heroContainer = document.querySelector(".coreContainer");
		const logoElement = document.querySelector(".hero-dslogo");
		const bounceText = document.querySelector(".bounceText");
		if (heroContainer) {
			heroContainer.classList.add("animate");
		}
		if (logoElement) {
			logoElement.classList.add("visible");
		}
		if (bounceText) {
			bounceText.classList.add("visible");
		}
	}, 1000); // Short delay to ensure DOM is ready
</script>
